{
    admin off
    auto_https off
}

:8080 {
    route {
        basic_auth {
            {$LOGS_UI_USERNAME} {$LOGS_UI_PASSWORD_HASH}
        }
        @root path /
        redir @root /select/vmui/ 302
        @read path /select/*
        reverse_proxy @read victorialogs:9428 {
            header_up -Authorization
        }
        respond "Not found" 404
    }
}
