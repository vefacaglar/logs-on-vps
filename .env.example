# Optional overrides; defaults work without an .env file.
VPS_LOG_HOST=vefa-vps
LOG_HTTP_PORT=9428
LOG_RETENTION=14d
# Soft retention threshold, not a hard filesystem quota (see README).
LOG_DISK_BUDGET=10GiB
LOG_MEMORY_LIMIT=768m
LOG_CPU_LIMIT=1.0
VECTOR_MEMORY_LIMIT=256m
VECTOR_CPU_LIMIT=0.5
# Rootless Docker users must set their actual host socket path here.
DOCKER_SOCKET_PATH=/var/run/docker.sock
